# Copy to terraform.tfvars. Nothing here is a secret - the database password is generated by
# Terraform and kept in Secret Manager, and the state (not this file) is what holds it.

project_id = "onetwotree-511013"
region     = "us-central1"

# Until the image is pushed to Artifact Registry, any resolvable reference lets `plan` run.
# After the push it is:
#   us-central1-docker.pkg.dev/onetwotree-511013/meetings-backend/backend:<tag>
image = "us-central1-docker.pkg.dev/onetwotree-511013/meetings-backend/backend:latest"

# Add the Firebase Hosting origin here once the site exists, so the API answers it. With the
# firebase.json rewrite in place the frontend calls /api/** on its own origin and this list
# only matters for local development.
cors_origins = [
  "http://localhost:3000",
  "http://localhost:5173",
]

# Sign-in stays on AWS Cognito (Part 2 moves the frontend, API and database only). Leave both
# empty to run with auth disabled, which is what the no-billing demo does.
cognito_user_pool_id = ""
cognito_client_id    = ""
